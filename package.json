{
  "name": "goal-tracker-api",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev:vercel": "npx vercel dev",
    "build": "tsc -p tsconfig.json",
    "build:vercel": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run prisma:migrate:deploy; else echo \"Skipping migrations for VERCEL_ENV=$VERCEL_ENV\"; fi && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier -w .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "dotenv": "^16",
    "pg": "^8",
    "prisma": "^6.16.3",
    "zod": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "husky": "^9.1.7",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.0.18"
  }
}
